# ==============================================================
# FOC-Birthday-Wishes Production Environment Configuration
# ==============================================================

# Timezone configuration for accurate birthday scheduling
TZ=Asia/Colombo

# Port to expose on the VPS host (connect via http://YOUR_VPS_IP:8080)
HOST_PORT=8080

# Security: Secret key required to access /qr and execute WhatsApp actions
# Leave empty for open access, or set a secure random string (e.g. openssl rand -hex 16)
ADMIN_API_KEY=your_secure_admin_key_here

# Frontend API base path (defaults to relative /api routed through Nginx)
VITE_BOT_URL=/api
