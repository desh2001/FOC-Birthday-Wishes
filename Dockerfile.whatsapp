
FROM node:22-bookworm-slim

ENV NODE_ENV=production
ENV TZ=Asia/Colombo

WORKDIR /app

# Install dependencies from the repository manifest.
COPY package*.json ./
RUN npm ci --omit=dev

# Copy the repository, including the bot.
COPY . .

# Persistent directory for authentication/session data.
RUN mkdir -p /app/whatsapp-data

CMD ["node", "whatsapp-bot.js"]
